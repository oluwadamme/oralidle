# Copy to `.env` for local development on native platforms.
#
# Web builds intentionally ship this file EMPTY: anything in it is served to
# the browser at /assets/.env, so the Gemini key lives on the server instead,
# behind api/gemini.js. CI copies this example over .env before building —
# `.env` is a declared Flutter asset, so the build fails if the file is absent.
#
# Native builds can also use the proxy and carry no key at all:
#   flutter build apk --dart-define=API_PROXY_BASE=https://your-app.vercel.app

# Used only on the direct-to-Google path (native development).
GEMINI_API_KEY=

# Local Ollama fallback. Native only — a local address is unreachable from a
# deployed web build.
OLLAMA_BASE_URL=
OLLAMA_MODEL=

# Supabase — cross-device history, audio storage, and the email link.
#
# Unlike the Gemini key these are safe in the bundle: the publishable key is
# public by design and row-level security is what protects the data. Web builds
# get them from Vercel env vars via the --dart-define in vercel.json; these
# entries are for native development.
#
# Release builds should pass them explicitly instead:
#   flutter build apk --dart-define=SUPABASE_URL=https://xxx.supabase.co \
#                     --dart-define=SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
#
# Leave both empty to run entirely on local Hive storage with no sync.
#
# NEVER put the sb_secret_ key here or in any --dart-define.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# hCaptcha sitekey. Public, like the Supabase key — the secret half lives in the
# Supabase dashboard under Auth > Attack Protection.
#
# Must be set for deployed builds. Left empty, HCaptchaConfig falls back to the
# hCaptcha *test* sitekey, whose tokens Supabase rejects against a real secret —
# which fails anonymous sign-in silently and stops all syncing.
HCAPTCHA_SITE_KEY=
