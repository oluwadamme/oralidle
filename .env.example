# Copy to `.env` for local development on native platforms.
#
# Web builds intentionally ship this file EMPTY: anything in it is served to
# the browser at /assets/.env, so the Gemini key lives on the server instead,
# behind api/gemini.js. CI copies this example over .env before building —
# `.env` is a declared Flutter asset, so the build fails if the file is absent.
#
# Native builds can also use the proxy and carry no key at all:
#   flutter build apk --dart-define=API_PROXY_BASE=https://your-app.vercel.app

# Used only on the direct-to-Google path (native development).
GEMINI_API_KEY=

# Local Ollama fallback. Native only — a local address is unreachable from a
# deployed web build.
OLLAMA_BASE_URL=
OLLAMA_MODEL=
